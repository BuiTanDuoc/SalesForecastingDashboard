@page
@model SalesForecastingDashboard.Pages.orders.CreateModel
@{
    Layout = "_Layout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/views/orders-create.css" asp-append-version="true" />
}

<div class="create-header">
    <h1 class="create-title">Create New Sale</h1>
    <p class="create-desc">Record a customer sale and automatically update product stock.</p>
</div>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="message-error">@Model.ErrorMessage</div>
}

<div class="form-box">
    <form method="post">

        <!-- SELECT PRODUCT -->
        <div class="form-group">
            <label class="form-label">Select Product</label>

            <div class="input-wrapper">
                <i class="fa-solid fa-box input-icon"></i>

                <select asp-for="Order.ProductId" class="form-control">
                    <option value="">Choose a product</option>
                    @foreach (var p in Model.Products)
                    {
                        <option value="@p.Id">@p.Name</option>
                    }
                </select>
            </div>
        </div>

        <!-- QUANTITY -->
        <div class="form-group">
            <label class="form-label">Quantity</label>

            <div class="input-wrapper">
                <i class="fa-solid fa-hashtag input-icon"></i>
                <input asp-for="Order.Quantity"
                       type="number"
                       class="form-control"
                       placeholder="e.g., 3" />
            </div>
        </div>

        <button type="submit" class="btn-save">
            <i class="fa-solid fa-check"></i> Submit Sale
        </button>

    </form>
</div>
